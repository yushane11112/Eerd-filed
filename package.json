{
  "name": "little-ear-island",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "qa:road-plans": "vitest run src/qa/roadPlanScenarios.test.ts",
    "qa:bridge-gaps": "vitest run src/qa/bridgeGapScenarios.test.ts",
    "qa:logistics-hotspots": "vitest run src/qa/logisticsHotspotScenarios.test.ts",
    "qa:service-governance": "vitest run src/qa/serviceGovernanceScenarios.test.ts",
    "qa:service-facility-runtime": "vitest run src/qa/serviceFacilityScenarios.test.ts",
    "qa:upgrade-economy-audit": "vite-node src/qa/upgradeEconomyAuditCheck.ts",
    "qa:logistics-storage-audit": "vite-node src/qa/logisticsStorageInterventionAuditCheck.ts",
    "qa:civilization-long-run": "vite-node src/qa/civilizationLongRunCheck.ts",
    "qa:civilization-scale": "vitest run src/qa/civilizationScale.test.ts",
    "qa:animation-runtime-budget": "vitest run src/qa/animationRuntimeBudget.test.ts",
    "qa:browser-e2e:contract": "vitest run src/qa/browserE2eScenarios.test.ts && BROWSER_E2E_CONTRACT_CLI=1 vite-node src/qa/browserE2eRunner.ts",
    "qa:browser-e2e": "npm run build && node tools/browser-e2e/run-browser-e2e.cjs",
    "qa:performance-baseline": "npm run build && vite-node tools/qa/run-performance-baseline.ts",
    "qa:render-ablation": "npm run build && vite-node tools/qa/run-render-ablation.ts",
    "asset:validate:self-test": "node tools/asset-validator/self-test.js",
    "asset:validate:gold-fixture": "node tools/asset-validator/asset-validator.js --building tools/asset-validator/fixtures/valid-building-manifest.json --animation tools/asset-validator/fixtures/valid-animation-manifest.json",
    "asset:validate:main-pier": "node tools/asset-validator/asset-validator.js --building docs/project/gold-slice/sample-manifests/main-pier/building-manifest.json --animation docs/project/gold-slice/sample-manifests/main-pier/animation-manifest.json",
    "asset:validate:main-homes:strict": "node tools/asset-validator/asset-validator.js --building docs/project/gold-slice/sample-manifests/main-homes/building-manifest.json --animation docs/project/gold-slice/sample-manifests/main-homes/animation-manifest.json --require-all-levels",
    "asset:validate:main-eatery:strict": "node tools/asset-validator/asset-validator.js --building docs/project/gold-slice/sample-manifests/main-eatery/building-manifest.json --animation docs/project/gold-slice/sample-manifests/main-eatery/animation-manifest.json --require-all-levels",
    "asset:validate:gold-samples": "node tools/asset-validator/validate-gold-samples.js",
    "asset:validate:gold-samples:strict": "node tools/asset-validator/validate-gold-samples.js --require-all-levels",
    "asset:coverage-audit": "node tools/asset-validator/asset-coverage-audit.js",
    "asset:coverage-audit:self-test": "node tools/asset-validator/asset-coverage-audit.self-test.js",
    "asset:runtime-artwork:audit": "node tools/asset-validator/runtime-artwork-audit.js",
    "asset:runtime-artwork:release-audit": "node tools/asset-validator/runtime-artwork-audit.js --runtime",
    "asset:runtime-artwork:budget": "node tools/asset-validator/runtime-artwork-budget-audit.js --runtime",
    "asset:pipeline:contract": "node tools/art-pipeline/validate-pipeline-contract.js",
    "asset:runtime-artwork:build": "node tools/art-pipeline/build-runtime-artwork-derivatives.js",
    "asset:runtime-artwork:atlas": "node tools/art-pipeline/build-runtime-artwork-atlases.js",
    "asset:runtime-artwork:atlas:audit": "node tools/asset-validator/runtime-artwork-atlas-audit.js",
    "asset:production-package:audit": "node tools/asset-validator/production-package-audit.js",
    "asset:production-package:self-test": "node tools/asset-validator/production-package-audit.js --self-test"
  },
  "dependencies": {
    "@pixi/react": "^8.0.3",
    "lucide-react": "^0.468.0",
    "pixi.js": "^8.6.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.61.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
