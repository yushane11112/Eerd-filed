{
  "name": "little-ear-island",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "asset:validate:self-test": "node tools/asset-validator/self-test.js",
    "asset:validate:gold-fixture": "node tools/asset-validator/asset-validator.js --building tools/asset-validator/fixtures/valid-building-manifest.json --animation tools/asset-validator/fixtures/valid-animation-manifest.json",
    "asset:validate:main-pier": "node tools/asset-validator/asset-validator.js --building docs/project/gold-slice/sample-manifests/main-pier/building-manifest.json --animation docs/project/gold-slice/sample-manifests/main-pier/animation-manifest.json",
    "asset:validate:main-homes:strict": "node tools/asset-validator/asset-validator.js --building docs/project/gold-slice/sample-manifests/main-homes/building-manifest.json --animation docs/project/gold-slice/sample-manifests/main-homes/animation-manifest.json --require-all-levels",
    "asset:validate:gold-samples": "node tools/asset-validator/validate-gold-samples.js",
    "asset:validate:gold-samples:strict": "node tools/asset-validator/validate-gold-samples.js --require-all-levels"
  },
  "dependencies": {
    "@pixi/react": "^8.0.3",
    "lucide-react": "^0.468.0",
    "pixi.js": "^8.6.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
